{
  "name": "toubcarmobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:api": "node scripts/check-api-coverage.mjs",
    "sync:api": "node scripts/sync-api-routes.mjs",
    "test:e2e-api": "node scripts/e2e-api-smoke.mjs",
    "test:all": "npm run typecheck && npm run check:api && npm run test:ci",
    "verify:test": "node scripts/verify-test-ready.mjs",
    "test": "jest --maxWorkers=2",
    "test:ci": "jest --ci --maxWorkers=2",
    "test:coverage": "jest --ci --coverage --maxWorkers=2",
    "test:watch": "jest --watch --maxWorkers=2",
    "eas:login": "eas login",
    "eas:init": "eas init",
    "eas:build:dev": "eas build --profile development --platform android",
    "eas:build:preview": "eas build --platform android --profile preview",
    "eas:build:preview:ios": "eas build --platform ios --profile preview",
    "eas:build:production": "eas build --platform android --profile production",
    "eas:build:production:all": "eas build --platform all --profile production"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.4",
    "@tanstack/react-query": "^5.74.4",
    "axios": "^1.8.4",
    "expo": "~54.0.35",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.0",
    "eas-cli": "^20.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.9.2"
  },
  "private": true
}
