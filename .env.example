# Backend Laravel (CarAgency) — PAS les identifiants MySQL Hostinger.
#
# Développement local :
#   EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
#   (Expo remplace 127.0.0.1 par l’IP LAN sur téléphone physique)
#
# Production Hostinger (base live) :
#   EXPO_PUBLIC_BACKEND_URL=https://toubcar.com
#   (sans /api à la fin — l’app ajoute /api automatiquement)
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
EXPO_PUBLIC_EAS_PROJECT_ID=
# Google OAuth (ID client Web — public, pas le secret)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
